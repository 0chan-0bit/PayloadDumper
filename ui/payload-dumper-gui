#!/usr/bin/env python3
"""Launcher for the payload-dumper GTK wrapper."""

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

try:
    from pd_gui.app import main
except (ImportError, ValueError) as exc:  # missing PyGObject/GTK/libadwaita
    sys.stderr.write(
        "无法启动 payload-dumper 图形界面：%s\n"
        "请安装 python3-gi、gir1.2-gtk-4.0、gir1.2-adw-1 "
        "（Debian/Ubuntu 包名），详见 ui/README.md。\n" % exc
    )
    sys.exit(1)

if __name__ == "__main__":
    sys.exit(main())
